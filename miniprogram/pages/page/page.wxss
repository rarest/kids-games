.classroom-header{padding:4px 2px 0}.classroom-header .heading{font-size:23px;margin:6px 0 10px;line-height:1.45}.page-navigation{margin:10px 0;gap:7px;flex-wrap:nowrap}.page-navigation button{font-size:14px;min-width:0;min-height:44px;padding:9px 10px;background:#fffefa}.page-picker{flex:1;min-width:100px}.page-picker .picker{font-size:14px;text-align:center;min-height:44px;padding:9px 8px}.page-shell .tabs{margin:12px 0}.reading-listen-actions{margin:10px 0}.reading-listen-actions button{font-size:14px;min-width:0;min-height:44px;padding:9px 10px}.reading-block{padding:14px 16px;margin:12px 0}.reading-block>.muted{font-size:13px;margin-bottom:8px}.reading-block .line{padding:14px 0}.reading-block .english{font-size:24px;margin-bottom:3px}.reading-block .row{margin:8px 0 0;gap:8px}.reading-block .row button{font-size:14px;min-height:44px;min-width:0;padding:9px 10px}.word-list .word-card{display:flex;align-items:flex-start;gap:12px;text-align:left}.word-card .word-art{flex-shrink:0;width:78px;height:78px;margin:3px 0;border-radius:13px;background:#f2f5e9}.word-content{flex:1;min-width:0}.word-card .english{font-size:24px;line-height:1.35}.word-card .muted{font-size:13px;line-height:1.6}.word-content>view:not(.english):not(.muted):not(.row){font-size:15px;line-height:1.6}.support-toggle{background:transparent;font-size:14px;color:#58704f}.practice-panel>.muted:first-child{font-size:13px}.practice-panel .choice{margin:10px 0}.practice-panel .subheading{font-size:22px;margin:15px 0 10px}.step-count{display:flex;justify-content:space-between;gap:10px;font-size:13px;color:#58704f;margin:8px 0}.speaking-panel{margin-top:12px;padding:16px}.speaking-panel .speaking{border-top:0;margin-top:14px;padding-top:0}.finished-round{text-align:center;padding:16px 0}.finished-star{font-size:48px;color:#a68a36;line-height:1.4}.finished-round>.muted{font-size:13px;margin-top:12px}
@media(min-width:700px){.page-shell{max-width:900px}.classroom-header .heading{font-size:30px}.page-navigation{max-width:440px}.tabs{max-width:660px}.word-card .word-art{width:110px;height:110px}.reading-block .english{font-size:28px}.word-list .word-card .row{max-width:380px}.practice-panel,.speaking-panel{max-width:760px}.reading-block{padding:20px 24px}}
@media(max-width:350px){.page-shell{padding-left:14px;padding-right:14px}.word-card .word-art{width:64px;height:64px}.word-card .english{font-size:22px}.reading-block .english{font-size:22px}.target-picker{font-size:14px}}

.reading-block .word-actions{flex-wrap:nowrap;gap:6px;margin-top:12px}.reading-block .word-actions button{font-size:13px;min-height:46px;padding:9px 6px;flex:1;min-width:0;line-height:1.6}.word-actions .practice-link{background:#f8efcf;color:#785d28}.word-actions .practice-link::after{border-color:#e9d9a8}.reading-block .line{padding-top:20px;padding-bottom:20px}.word-card .word-art{width:64px;height:64px}.word-content>view:not(.english):not(.muted):not(.row){font-size:16px;line-height:1.8}.practice-panel .choice{min-height:54px;line-height:1.7}.practice-panel .subheading{line-height:1.7}.target-picker{white-space:normal;line-height:1.7}
@media(min-width:700px){.word-card .word-art{width:100px;height:100px}.reading-block .word-actions{max-width:480px;gap:10px}.reading-block .word-actions button{font-size:16px;min-height:50px}.reading-block .line{padding:24px 0}.page-reading{max-width:800px}}
