.classroom-header{padding:8px 2px 0}.classroom-header .heading{font-size:25px;margin:8px 0 10px;line-height:1.5}.page-navigation{margin:12px 0}.page-navigation button{font-size:15px;min-height:44px;padding:10px 14px;background:#fffefa}.page-reading>.primary{margin:16px 0}.word-panel{padding:17px 13px}.word-panel>.subheading{margin:0 5px 12px;font-size:20px}.words-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.word-card{padding:12px 9px;background:#f6f8ef;border:1px solid #e5ebdc;border-radius:18px;text-align:center;min-width:0}.word-card:last-child{border-bottom:1px solid #e5ebdc}.word-card .word-art{width:100%;max-width:130px;height:112px;margin:0 auto 10px}.word-card .english{font-size:23px;line-height:1.5}.word-card .muted{font-size:12px;line-height:1.6;margin:3px 0}.word-card .row{margin:11px 0 0;gap:6px}.word-card .row button{font-size:12px;min-width:0;min-height:44px;padding:10px 4px;border-radius:11px;background:#fffefa}.reading-block>.subheading{font-size:20px;margin:0 0 5px}.reading-block>.line{padding:17px 0 8px}.reading-block .english{font-size:25px;margin-bottom:6px}.reading-block .row button{font-size:15px}.practice-panel>.muted:first-child{font-size:13px}.practice-panel .choice{margin:10px 0;border-radius:16px;background:#f1f5e7}.practice-panel .subheading{font-size:23px;margin:18px 0 12px}.speaking-panel .choice{font-size:20px;line-height:1.5;background:#f3f6eb}.speaking-panel .choice.selected{background:#e0edd3}
@media(min-width:700px){.page-shell{max-width:1000px}.classroom-header .heading{font-size:33px}.page-navigation{max-width:380px}.tabs{max-width:660px;margin:20px 0}.tabs button{font-size:17px}.word-panel{padding:23px}.words-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.word-card{padding:18px}.word-card .word-art{max-width:160px;height:155px}.word-card .english{font-size:28px}.word-card .row button{font-size:15px}.reading-block .english{font-size:29px}.reading-block .row{max-width:420px}.practice-panel,.speaking-panel{max-width:760px}}
@media(max-width:350px){.word-card{padding:10px 6px}.word-card .english{font-size:20px}.word-card .row{display:block}.word-card .row button{width:100%;margin-top:6px}.words-grid{gap:8px}.reading-block .english{font-size:23px}}
