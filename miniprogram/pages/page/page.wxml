<import src="../../components/speaking.wxml"/>
<view class="shell page-shell"><view wx:if="{{loading}}">正在加载课本…</view><view class="error" wx:if="{{error}}">{{error}}</view><button wx:if="{{error}}" bindtap="load">重试</button><view wx:if="{{page && !loading}}"><view class="classroom-header"><view class="eyebrow">珠珠英语课堂 · 课本第 {{page.page}} 页</view><view class="heading">{{page.title}}</view></view><view class="row page-navigation"><button data-delta="-1" bindtap="changePage" disabled="{{page.page === 2}}">上一页</button><button data-delta="1" bindtap="changePage" disabled="{{page.page === 91}}">下一页</button></view><view class="tabs"><button class="{{tab === 'read' ? 'selected' : ''}}" data-tab="read" bindtap="switchTab">逐页听读</button><button class="{{tab === 'practice' ? 'selected' : ''}}" data-tab="practice" bindtap="switchTab">本页练习</button><button class="{{tab === 'speak' ? 'selected' : ''}}" data-tab="speak" bindtap="switchTab">跟读录音</button></view>
 <view wx:if="{{tab === 'read'}}" class="page-reading"><button class="primary" bindtap="readPage">依次听这一页</button><button wx:if="{{media.playing}}" bindtap="stopAudio">停止播放</button><view class="panel word-panel" wx:if="{{page.words.length}}"><view class="subheading">本页单词</view><view class="words-grid"><view wx:for="{{page.words}}" wx:key="targetId" class="line word-card"><image wx:if="{{item.imageURL}}" class="word-art" src="{{item.imageURL}}" mode="aspectFit"/><view class="english">{{item.en}}</view><view class="muted">{{item.ipa}}</view><view>{{item.zh}}</view><view class="row"><button wx:if="{{item.audio}}" data-id="{{item.targetId}}" bindtap="listenTarget">听示范</button><button wx:if="{{item.audio && item.speakable !== false}}" data-id="{{item.targetId}}" bindtap="chooseAndSpeak">我来读</button></view></view></view></view><view wx:for="{{page.blocks}}" wx:key="index" class="panel reading-block"><view class="subheading">{{item.title}}</view><view wx:if="{{item.tip}}" class="muted">{{item.tip}}</view><view wx:for="{{item.lines}}" wx:for-item="line" wx:key="targetId" class="line"><view class="english">{{line.en}}</view><view>{{line.zh}}</view><view class="row"><button wx:if="{{line.audio}}" data-id="{{line.targetId}}" bindtap="listenTarget">听这一句</button><button wx:if="{{line.audio && line.speakable !== false}}" data-id="{{line.targetId}}" bindtap="chooseAndSpeak">读这一句</button></view></view></view></view>
 <view wx:if="{{tab === 'practice'}}" class="panel practice-panel"><view class="muted">本页练习记录保存在当前孩子的这台设备。</view><view wx:if="{{question}}"><view class="muted">第 {{questionIndex}} 题 / {{questions.length}} 题</view><view class="subheading">{{question.prompt}}</view><button bindtap="listenQuestion">听题目原句</button><button wx:if="{{media.playing}}" bindtap="stopAudio">停止播放</button><button wx:for="{{question.choices}}" wx:key="*this" class="choice" data-answer="{{item}}" bindtap="answer" disabled="{{feedback.correct}}">{{item}}</button><view wx:if="{{question.kind === 'order'}}"><view class="tokens"><button wx:for="{{picked}}" wx:key="position" data-index="{{item.position}}" bindtap="removeToken" disabled="{{feedback.correct}}">{{item.text}}</button><view wx:if="{{!picked.length}}" class="muted">按顺序点词块</view></view><view class="tokens"><button wx:for="{{tokens}}" wx:key="index" data-index="{{item.index}}" bindtap="pick" disabled="{{item.selected || feedback.correct}}">{{item.text}}</button></view><button bindtap="checkSentence" disabled="{{picked.length !== tokens.length || feedback.correct}}">检查这句话</button></view><view wx:if="{{feedback}}" class="notice">{{feedback.text}}</view><button class="primary" bindtap="nextQuestion" disabled="{{!feedback.correct}}">下一题</button></view><view wx:if="{{practiceFinished}}"><view class="subheading">这一轮练完了</view><view>隔一会再试着回忆，也可以选一句跟读。</view><button bindtap="restartPractice">再练一轮</button></view></view>
 <view wx:if="{{tab === 'speak'}}" class="panel speaking-panel"><view class="subheading">选一个词或句子跟读</view><button wx:for="{{page.targets}}" wx:key="id" wx:if="{{item.audio && item.speakable !== false}}" class="choice {{speakingTarget.id === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseTarget">{{item.en}}</button><template is="speaking" data="{{speakingTarget, media}}"/></view>
</view></view>
