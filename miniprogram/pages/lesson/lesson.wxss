.classroom-header{padding:8px 2px 2px}.classroom-header .heading{margin-bottom:8px}.lesson-goal{font-size:16px;line-height:1.8;color:#586e58}.book-link{display:inline-block;margin:13px 0 0;font-size:14px;background:#fffefa;min-height:42px;padding:9px 13px}.book-link text{margin-left:10px;color:#58794e}.step-panel{margin-top:20px}.step-count{display:flex;justify-content:space-between;align-items:center;gap:12px;color:#5a7351;font-size:13px;font-weight:600}.step-count text:last-child{padding:2px 10px;border-radius:15px;background:#edf3e4}.lesson-scene{height:240px;border-radius:19px;background:#f2f5e9}.word-focus{padding:5px 0 12px;text-align:center}.word-focus .word-art{width:170px;height:170px;margin:8px auto 16px;background:#f2f5e9;border-radius:25px}.word-focus .english{font-size:37px}.word-focus .muted{margin:3px 0 6px}.phrase-focus{padding:6px 0 12px}.phrase-focus .english{margin-bottom:8px}.answer-feedback{border-left:4px solid #94a778}.feedback-correct{background:#ecf4df;border-color:#bdd7a4}.feedback-retry{background:#fcf1df;border-color:#e8d4ad}.listen-button{background:#f8edcf;border-color:#e8d8ae;color:#68562d}.listen-button::after{border-color:#e8d8ae}.next-button{margin-top:16px}.finished-panel{text-align:center;padding:28px 22px;background:#fffdf2}.finished-star{width:64px;height:64px;border-radius:24px;background:#f5df99;color:#887139;line-height:64px;font-size:38px;margin:0 auto 15px}.finished-panel .subheading{font-size:25px}.finished-panel button{margin-top:22px}
@media(min-width:700px){.lesson-shell{max-width:850px}.step-panel{padding:28px 36px}.lesson-scene{height:330px}.word-focus .word-art{width:210px;height:210px}.word-focus .english{font-size:43px}.classroom-header .heading{font-size:32px}.step-panel>.primary,.step-panel>.listen-button{max-width:560px;width:100%;margin-left:auto;margin-right:auto}}
@media(max-width:350px){.step-panel{padding:16px}.lesson-scene{height:190px}.word-focus .english{font-size:33px}}
