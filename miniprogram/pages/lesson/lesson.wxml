<import src="../../components/speaking.wxml"/>
<view class="shell lesson-shell action-shell"><view wx:if="{{loading}}">正在加载导学课…</view><view class="error" wx:if="{{error}}">{{error}}</view><button wx:if="{{error}}" bindtap="load">重试</button><view wx:if="{{lesson}}"><view class="classroom-header"><view class="eyebrow">珠珠英语课堂 · {{sync}}</view><view class="heading">{{lesson.title}}</view><view class="lesson-goal">{{lesson.goal}}</view><button class="small book-link" bindtap="openPage" disabled="{{mediaLocked}}">课本第 {{lesson.pages[0]}} 页 <text>↗</text></button></view><view wx:if="{{finished}}" class="panel finished-panel"><view class="finished-star">★</view><view class="subheading">这一课，完成了！</view><view>记住词句需要多次练习。隔一天再试着回忆。</view><button class="primary" bindtap="home">回到课程</button></view><view wx:if="{{step}}" class="panel step-panel"><view class="step-count"><text>每一步，都在进步</text><text>{{index}} / {{total}}</text></view><progress class="progress" percent="{{(index - 1) * 100 / total}}" activeColor="#355e46"/>
 <view wx:if="{{step.kind === 'word'}}" class="word-focus"><image wx:if="{{step.word.imageURL}}" class="word-art" src="{{step.word.imageURL}}" mode="aspectFit"/><view class="english">{{step.word.en}}</view><view class="muted">{{step.word.ipa}}</view><view>{{step.word.zh}}</view><view class="muted">听一遍，再自己跟着说一遍。</view></view>
 <view wx:if="{{step.kind === 'phrase'}}" class="phrase-focus"><view class="english">{{step.phrase.en}}</view><view>{{step.phrase.zh}}</view><view class="notice" wx:if="{{step.phrase.tip}}">{{step.phrase.tip}}</view></view>
 <view wx:if="{{step.prompt}}" class="subheading">{{step.prompt}}</view>
 <view wx:if="{{step.kind === 'letters' || step.kind === 'reading'}}" class="step-target-selection"><view class="step-count"><text>{{step.kind === 'letters' ? '字母的名字和声音' : '一句一句读'}} </text><text>{{stepTargetIndex + 1}} / {{stepTargetItems.length}}</text></view><picker range="{{stepTargetItems}}" range-key="en" value="{{stepTargetIndex}}" bindchange="selectStepTarget" disabled="{{mediaLocked}}"><view class="picker target-picker">第 {{stepTargetIndex + 1}} {{step.kind === 'letters' ? '个字母' : '句'}} <text>{{step.kind === 'letters' ? '换一个' : '换一句'}} ▾</text></view></picker><view class="row target-navigation"><button data-delta="-1" bindtap="adjacentStepTarget" disabled="{{stepTargetIndex === 0 || mediaLocked}}">上一个</button><button data-delta="1" bindtap="adjacentStepTarget" disabled="{{stepTargetIndex + 1 >= stepTargetItems.length || mediaLocked}}">下一个</button></view><view wx:if="{{stepTargetItem.tip}}" class="notice">{{stepTargetItem.tip}}</view><view wx:if="{{step.kind === 'letters' && stepTargetItem.ipa}}" class="muted">{{stepTargetItem.ipa}}</view><view wx:if="{{step.kind === 'letters'}}" class="muted">例词 {{stepTargetItem.example}} · {{stepTargetItem.sound}}</view><view wx:if="{{!speakingTarget}}" class="line"><view class="english">{{stepTargetItem.en}}</view><view>{{stepTargetItem.zh}}</view></view></view>
 <button wx:for="{{step.choices}}" wx:key="*this" class="choice {{feedback.selected === item ? (feedback.correct ? 'answer-correct' : 'answer-retry') : ''}}" data-answer="{{item}}" bindtap="answer" disabled="{{feedback.correct || mediaLocked}}"><text>{{item}}</text><text wx:if="{{feedback.selected === item}}" class="choice-marker">{{feedback.correct ? '✓ 答对了' : '↻ 再试试'}}</text></button>
 <view wx:if="{{step.kind === 'sentence'}}"><view class="tokens"><button wx:for="{{picked}}" wx:key="position" data-index="{{item.position}}" bindtap="removeToken" disabled="{{feedback.correct || mediaLocked}}">{{item.text}}</button><view wx:if="{{!picked.length}}" class="muted">按顺序点词块</view></view><view class="tokens"><button wx:for="{{tokens}}" wx:key="index" data-index="{{item.index}}" disabled="{{item.selected || feedback.correct || mediaLocked}}" bindtap="pick">{{item.text}}</button></view><button bindtap="checkSentence" disabled="{{picked.length !== tokens.length || feedback.correct || mediaLocked}}">检查这句话</button></view>
 <view wx:if="{{feedback}}" class="notice answer-feedback {{feedback.correct ? 'feedback-correct' : 'feedback-retry'}}"><view>{{feedback.correct ? '答对了，继续试试！' : '再听一听、看一看。'}}</view><view>{{feedback.why}}</view></view>
 <view wx:if="{{step.kind === 'oral'}}"><view>{{step.title}}</view><view class="notice" wx:if="{{step.example}}">可以从这句话开始：{{step.example}}</view><view class="muted">和家人做一次活动，这里记录一次尝试。</view><button bindtap="markOral" disabled="{{mediaLocked}}">我已和家人完成活动</button></view>
 <template is="speaking" data="{{speakingTarget, media, showSpeakingHelp, hideTarget: step.kind !== 'reading' && step.kind !== 'letters' && step.kind !== 'oral' && !feedback.correct}}"/>
 <button class="listen-button" wx:if="{{canListen && !speakingTarget}}" bindtap="listen" disabled="{{mediaLocked}}">{{media.source === 'lesson' && media.playing ? '暂停播放' : media.source === 'lesson' && media.paused ? '继续播放' : '听美式示范'}}</button>
<image wx:if="{{lesson.imageURL && (step.kind === 'phrase' || step.kind === 'reading' || step.kind === 'oral')}}" class="art lesson-scene" src="{{lesson.imageURL}}" mode="aspectFit" aria-label="{{lesson.imageAlt}}"/>
</view><view wx:if="{{step}}" class="bottom-actions"><view wx:if="{{mediaLocked}}" class="action-hint">先提交或丢弃这次录音，再继续。</view><button class="primary next-button" bindtap="next" disabled="{{!canNext || mediaLocked}}">{{index === total ? '完成这一课' : '下一步'}}</button></view></view></view>
