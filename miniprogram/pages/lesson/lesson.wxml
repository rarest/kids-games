<import src="../../components/speaking.wxml"/>
<view class="shell lesson-shell"><view wx:if="{{loading}}">正在加载导学课…</view><view class="error" wx:if="{{error}}">{{error}}</view><button wx:if="{{error}}" bindtap="load">重试</button><view wx:if="{{lesson}}"><view class="classroom-header"><view class="eyebrow">珠珠英语课堂 · {{sync}}</view><view class="heading">{{lesson.title}}</view><view class="lesson-goal">{{lesson.goal}}</view><button class="small book-link" bindtap="openPage">课本第 {{lesson.pages[0]}} 页 <text>↗</text></button></view><view wx:if="{{finished}}" class="panel finished-panel"><view class="finished-star">★</view><view class="subheading">这一课，完成了！</view><view>记住词句需要多次练习。隔一天再试着回忆。</view><button class="primary" bindtap="home">回到课程</button></view><view wx:if="{{step}}" class="panel step-panel"><view class="step-count"><text>每一步，都在进步</text><text>{{index}} / {{total}}</text></view><progress class="progress" percent="{{(index - 1) * 100 / total}}" activeColor="#355e46"/><image wx:if="{{lesson.imageURL && (step.kind === 'phrase' || step.kind === 'reading' || step.kind === 'oral')}}" class="art lesson-scene" src="{{lesson.imageURL}}" mode="aspectFit" aria-label="{{lesson.imageAlt}}"/>
 <view wx:if="{{step.kind === 'word'}}" class="word-focus"><image wx:if="{{step.word.imageURL}}" class="word-art" src="{{step.word.imageURL}}" mode="aspectFit"/><view class="english">{{step.word.en}}</view><view class="muted">{{step.word.ipa}}</view><view>{{step.word.zh}}</view><view class="muted">听一遍，再自己跟着说一遍。</view></view>
 <view wx:if="{{step.kind === 'phrase'}}" class="phrase-focus"><view class="english">{{step.phrase.en}}</view><view>{{step.phrase.zh}}</view><view class="notice" wx:if="{{step.phrase.tip}}">{{step.phrase.tip}}</view></view>
 <view wx:if="{{step.prompt}}" class="subheading">{{step.prompt}}</view>
 <view wx:if="{{step.kind === 'letters'}}"><view class="subheading">字母有名字，也有声音</view><view wx:for="{{step.letters}}" wx:key="en" class="line"><view class="english">{{item.en}}</view><view>{{item.ipa}}</view><view>例词 {{item.example}} · {{item.sound}}</view><button wx:if="{{item.audio}}" data-id="{{item.targetId}}" bindtap="listenTarget">听字母</button></view></view>
 <view wx:if="{{step.kind === 'reading'}}"><view wx:for="{{step.lines}}" wx:key="index" class="line"><view class="english">{{item.en}}</view><view>{{item.zh}}</view><view class="row"><button wx:if="{{item.audio}}" data-id="{{item.targetId}}" bindtap="listenTarget">听这一句</button><button wx:if="{{item.audio && item.speakable !== false}}" data-id="{{item.targetId}}" bindtap="chooseTarget">读这一句</button></view></view></view>
 <button wx:for="{{step.choices}}" wx:key="*this" class="choice" data-answer="{{item}}" bindtap="answer" disabled="{{feedback.correct}}">{{item}}</button>
 <view wx:if="{{step.kind === 'sentence'}}"><view class="tokens"><button wx:for="{{picked}}" wx:key="position" data-index="{{item.position}}" bindtap="removeToken" disabled="{{feedback.correct}}">{{item.text}}</button><view wx:if="{{!picked.length}}" class="muted">按顺序点词块</view></view><view class="tokens"><button wx:for="{{tokens}}" wx:key="index" data-index="{{item.index}}" disabled="{{item.selected || feedback.correct}}" bindtap="pick">{{item.text}}</button></view><button bindtap="checkSentence" disabled="{{picked.length !== tokens.length || feedback.correct}}">检查这句话</button></view>
 <view wx:if="{{feedback}}" class="notice answer-feedback {{feedback.correct ? 'feedback-correct' : 'feedback-retry'}}"><view>{{feedback.correct ? '答对了，继续试试！' : '再听一听、看一看。'}}</view><view>{{feedback.why}}</view></view>
 <view wx:if="{{step.kind === 'oral'}}"><view>{{step.title}}</view><view class="notice" wx:if="{{step.example}}">可以从这句话开始：{{step.example}}</view><view class="muted">和家人做一次活动，这里记录一次尝试。</view><button bindtap="markOral">我已和家人完成活动</button></view>
 <button class="listen-button" wx:if="{{canListen}}" bindtap="listen" disabled="{{media.recording || media.requesting}}">听美式示范</button><button wx:if="{{media.playing && !speakingTarget}}" bindtap="stopAudio">停止播放</button><button class="primary next-button" bindtap="next" disabled="{{!canNext}}">{{index === total ? '完成这一课' : '下一步'}}</button><template is="speaking" data="{{speakingTarget, media}}"/>
</view></view></view>
