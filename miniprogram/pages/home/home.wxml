<view class="shell home-shell">
 <view class="home-header">
  <view class="brand"><view class="brand-mark">珠</view><view><view class="brand-title">珠珠学伴</view><view class="brand-caption">珠珠英语课堂</view></view></view>
  <button class="account-button small" bindtap="account">家长与档案</button>
 </view>
 <view class="profile-line"><text>{{profileName}}</text><text class="sync-label">{{sync}}</text></view>
 <view wx:if="{{loading}}" class="notice">正在为你打开课本…</view>
 <view wx:if="{{error}}" class="notice error"><view>{{error}}</view><button bindtap="load">再试一次</button></view>
 <view wx:if="{{recommended && !loading}}" class="today-card">
  <view class="today-art-wrap"><image class="today-art" src="{{recommended.imageURL}}" mode="aspectFit" aria-label="{{recommended.unitTitle}}单元插画"/><view class="today-badge">{{recommended.resuming ? '接着上次学' : recommended.reviewing ? '今天再回忆' : '今天学这一课'}}</view></view>
  <view class="today-content"><view class="eyebrow">UNIT {{recommended.unitNumber}} · {{recommended.unitTitle}}</view><view class="today-title">{{recommended.title}}</view><view class="today-goal">{{recommended.goal}}</view><view class="today-meta"><text>{{recommended.minutes}} 分钟</text><text>课本 {{recommended.pagesLabel}} 页</text></view><button class="primary today-start" data-id="{{recommended.id}}" bindtap="openLesson">{{recommended.resuming ? '接着学' : recommended.reviewing ? '再练一课' : '开始今天的一课'}} <text>→</text></button></view>
 </view>
 <view wx:if="{{catalog && !loading}}">
  <view class="section-heading"><view><view class="subheading">六个小世界</view><view class="muted">选一幅画，打开这一单元</view></view><view class="completion-pill">已学 {{completedCount}} / {{lessonCount}} 课</view></view>
  <view class="unit-grid">
   <view wx:for="{{units}}" wx:key="id" class="unit-card unit-{{item.number}} {{expandedUnit === item.id ? 'unit-expanded' : ''}}">
    <button class="unit-toggle" data-id="{{item.id}}" bindtap="toggleUnit" aria-label="{{item.zh}}，{{expandedUnit === item.id ? '收起课程' : '查看课程'}}">
     <view class="unit-art-wrap"><image class="unit-art" src="{{item.imageURL}}" mode="aspectFit" aria-label="{{item.zh}}单元插画"/><view class="unit-number">{{item.number}}</view></view>
     <view class="unit-summary"><view class="unit-title">{{item.zh}}</view><view class="unit-english">{{item.title}}</view><view class="unit-bottom"><text>{{item.completedCount}} / {{item.lessonCount}} 课</text><text class="unit-expand-label">{{expandedUnit === item.id ? '收起 −' : '选课 +'}} </text></view></view>
    </button>
    <view wx:if="{{expandedUnit === item.id}}" class="unit-lessons">
     <button wx:for="{{item.lessons}}" wx:for-item="lesson" wx:key="id" class="lesson-choice" data-id="{{lesson.id}}" bindtap="openLesson"><view class="lesson-order {{lesson.completed ? 'is-complete' : ''}}">{{lesson.completed ? '✓' : lesson.number}}</view><view class="lesson-label"><view>{{lesson.title}}</view><view class="muted">{{lesson.minutes}} 分钟 · {{lesson.completed ? '已完成 · 可再练' : '课本 ' + lesson.pagesLabel + ' 页'}}</view></view><text class="lesson-arrow">›</text></button>
    </view>
   </view>
  </view>
  <view class="textbook-card"><view class="textbook-heading"><view class="book-mark">Aa</view><view><view class="subheading">按课本页码学习</view><view class="muted">听读、练习、跟读，选一页就出发</view></view></view><view class="page-picker-row"><button class="page-picker page-picker-button" bindtap="openPageDirectory" aria-label="选择课本页码"><view class="picker"><view class="picker-page">第 {{selectedPage.page}} 页 <text>⌄</text></view><view class="picker-title">{{selectedPage.title}}</view></view></button><button class="primary open-page" bindtap="openSelectedPage">打开</button></view></view>
  <view class="home-footer">先听一听，再试着说。每一次尝试都算数。</view>
 </view>
</view>

<view wx:if="{{pageDirectoryOpen}}" class="page-directory-backdrop" bindtap="closePageDirectory"><view class="page-directory-sheet" catchtap="stopSheetTap"><view class="directory-heading"><view class="subheading">选择课本页码</view><button class="small" bindtap="closePageDirectory">关闭</button></view><picker mode="selector" range="{{pageGroupLabels}}" value="{{pageGroupIndex}}" bindchange="selectPageGroup"><view class="picker directory-unit">{{pageGroupLabels[pageGroupIndex]}} <text>⌄</text></view></picker><scroll-view class="page-directory-list" scroll-y="{{true}}"><button wx:for="{{directoryPages}}" wx:key="page" class="directory-page {{item.page === selectedPage.page ? 'directory-selected' : ''}}" data-page="{{item.page}}" bindtap="chooseDirectoryPage"><text class="directory-page-number">{{item.page}}</text><view class="directory-page-title">{{item.title}}</view><text wx:if="{{item.page === selectedPage.page}}">✓</text></button></scroll-view></view></view>
