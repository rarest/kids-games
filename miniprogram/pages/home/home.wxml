<view class="shell"><view class="eyebrow">照片教材 · 美式听读</view><view class="heading">每天学一小课</view><view class="muted">{{profileName}} · {{sync}}</view><button bindtap="account">家长账号与孩子档案</button><view class="notice">先认识词句，再听、选、拼、读。访客也可以学习，导学进度先保存在此设备。</view><view wx:if="{{loading}}">正在加载教材…</view><view class="error" wx:if="{{error}}">{{error}}</view><button wx:if="{{error}}" bindtap="load">重试加载</button><view wx:for="{{catalog.units}}" wx:key="id" class="panel"><view class="subheading">{{item.title}}</view><view class="muted">{{item.zh}}</view><view wx:for="{{item.lessons}}" wx:for-item="lesson" wx:key="id" class="list-row"><view class="block-title">{{lesson.title}}</view><view>{{lesson.goal}}</view><view class="muted">{{lesson.minutes}} 分钟 · 课本 {{lesson.pages}} 页 {{completed[lesson.id].completed ? '· 已完成一课' : ''}}</view><button class="primary" data-id="{{lesson.id}}" bindtap="openLesson">开始 / 接着学</button></view></view><view class="panel"><view class="subheading">逐页课堂 · 90 页</view><view class="muted">按照片课本顺序听读、练习和跟读。</view><button wx:for="{{catalog.pages}}" wx:key="page" class="choice" data-page="{{item.page}}" bindtap="openPage">第 {{item.page}} 页 · {{item.title}}</button></view></view>
