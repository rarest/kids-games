page{background:#f7f5ef;color:#273e38;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:18px;line-height:1.8}.shell{padding:22px 18px 36px}.heading{font-size:30px;font-weight:700;line-height:1.4;margin:12px 0 16px}.subheading{font-size:23px;font-weight:700;line-height:1.6;margin:8px 0}.english{font-size:28px;line-height:1.6;font-weight:650;overflow-wrap:break-word}.muted{font-size:15px;color:#69776c;line-height:1.8}.eyebrow{font-size:14px;color:#627b60}.panel{background:#fffdfa;border:1px solid #e4e7da;border-radius:22px;padding:20px;margin:18px 0}.notice{padding:14px 16px;background:#edf0e1;border-radius:14px;margin:14px 0;line-height:1.8}.error{color:#984b3f}.row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:14px 0}.row button{flex:1;min-width:110px;margin:0}.list-row{border-bottom:1px solid #e8ebdf;padding:18px 0}.list-row:last-child{border:0}button{font-size:18px;line-height:1.6;min-height:48px;padding:10px 16px;border-radius:13px;background:#edf0e5;color:#365b42;margin:10px 0;white-space:normal}button::after{border:1px solid #dbe3d2}button.primary{background:#355e46;color:#fff}button[disabled]{opacity:.5;color:#69776c}button.selected{background:#dce8cf;font-weight:700}button.small{font-size:16px;min-height:44px;padding:8px 14px}.choice{width:100%;text-align:left;padding:13px 18px}.tabs{display:flex;gap:6px;margin:16px 0}.tabs button{font-size:16px;min-width:0;flex:1;margin:0;padding:10px 6px}.art{width:100%;height:190px;margin:12px 0}.word-art{width:150px;height:150px;display:block;margin:12px auto}.line{padding:18px 0;border-bottom:1px solid #e8ebdf}.tokens{display:flex;flex-wrap:wrap;gap:8px;min-height:52px;background:#f2f4e9;padding:12px;border-radius:12px;margin:12px 0}.tokens button{margin:0;min-height:46px;padding:7px 12px}.form-label{display:block;margin:18px 0 8px;font-weight:600}.input{border:1px solid #cdd8ca;border-radius:12px;background:#fff;min-height:48px;padding:8px 12px;font-size:18px;box-sizing:border-box}.picker{padding:10px 14px;border:1px solid #cdd8ca;border-radius:12px;min-height:48px;box-sizing:border-box}.score{font-size:26px;font-weight:700;line-height:1.5}.profile{border:1px solid #dbe3d2;border-radius:14px;padding:14px;margin:12px 0}.progress{height:8px;margin:18px 0}.speaking{border-top:1px solid #dbe3d2;margin-top:20px;padding-top:18px}.block-title{font-size:21px;font-weight:650;line-height:1.6}.link{color:#355e46}
