page{background:#f7f8ef;color:#263e31;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:18px;line-height:1.75}.shell{max-width:960px;box-sizing:border-box;margin:0 auto;padding:22px 18px 36px;padding-bottom:calc(36px + env(safe-area-inset-bottom))}.heading{font-size:29px;font-weight:700;line-height:1.4;margin:10px 0 14px}.subheading{font-size:23px;font-weight:700;line-height:1.5;margin:8px 0}.english{font-size:28px;line-height:1.55;font-weight:650;overflow-wrap:break-word}.muted{font-size:15px;color:#657665;line-height:1.75}.eyebrow{font-size:13px;font-weight:600;color:#58704f;line-height:1.7}.panel{background:#fffefa;border:1px solid #e1e8d8;border-radius:23px;padding:20px;margin:18px 0;box-shadow:0 4px 18px rgba(48,70,39,.025)}.notice{padding:14px 16px;background:#edf2e3;border:1px solid #e0e8d6;border-radius:15px;margin:14px 0;line-height:1.75}.error{color:#974939}.row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:14px 0}.row button{flex:1;min-width:110px;margin:0}.list-row{border-bottom:1px solid #e7ecdE;padding:18px 0}.list-row:last-child{border:0}button{font-size:18px;line-height:1.5;min-height:48px;padding:12px 16px;border-radius:15px;background:#edf2e5;color:#31583d;margin:10px 0;white-space:normal;font-weight:600;box-sizing:border-box}button::after{border:1px solid #dce6d2;border-radius:15px}button.primary{background:#315e46;color:#fffefa;box-shadow:0 4px 10px rgba(49,94,70,.1)}button.primary::after{border:1px solid #315e46}button[disabled]{opacity:.5;color:#657665;box-shadow:none}button.selected{background:#e0edd3;color:#2d593c;font-weight:700}button.small{font-size:16px;min-height:44px;padding:9px 14px}.choice{width:100%;text-align:left;padding:14px 18px}.tabs{display:flex;gap:6px;margin:16px 0;background:#eaf0e1;border-radius:17px;padding:5px}.tabs button{font-size:15px;min-width:0;flex:1;margin:0;padding:10px 5px;background:transparent;border-radius:12px}.tabs button::after{border:0}.tabs button.selected{background:#fffefa;box-shadow:0 2px 6px rgba(42,65,35,.06)}.art{width:100%;height:220px;margin:12px 0}.word-art{width:150px;height:150px;display:block;margin:12px auto}.line{padding:18px 0;border-bottom:1px solid #e7ecdE}.line:last-child{border-bottom:0}.tokens{display:flex;flex-wrap:wrap;gap:8px;min-height:52px;background:#f0f4e6;padding:12px;border-radius:15px;margin:12px 0}.tokens button{margin:0;min-height:46px;padding:8px 12px;background:#fffefa;border-radius:11px}.form-label{display:block;margin:18px 0 8px;font-weight:600}.input{border:1px solid #ccd9c4;border-radius:13px;background:#fffefa;min-height:48px;padding:8px 12px;font-size:18px;box-sizing:border-box}.picker{padding:10px 14px;border:1px solid #ccd9c4;background:#fffefa;border-radius:13px;min-height:48px;box-sizing:border-box}.score{font-size:26px;font-weight:700;line-height:1.5}.profile{border:1px solid #dce6d2;background:#fffefa;border-radius:16px;padding:14px;margin:12px 0}.progress{height:8px;margin:14px 0 18px}.speaking{border-top:1px solid #dce6d2;margin-top:20px;padding-top:18px}.block-title{font-size:21px;font-weight:650;line-height:1.6}.link{color:#315e46}
@media(min-width:700px){.shell{padding:32px 30px 46px}.heading{font-size:34px}.panel{padding:26px}.art{height:310px}}
