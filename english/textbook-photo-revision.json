    {
      "page": 75,
      "title": "观察、圈选与表演",
      "blocks": [
        {
          "title": "Look and circle",
          "kind": "activity",
          "lines": [
            {
              "en": "Look and circle.",
              "zh": "看一看，圈一圈。"
            },
            {
              "en": "How many baby cats?",
              "zh": "有几只小猫？"
            },
            {
              "en": "Six.",
              "zh": "六只。"
            },
            {
              "en": "Seven.",
              "zh": "七只。"
            },
            {
              "en": "Eight.",
              "zh": "八只。"
            },
            {
              "en": "What colours are the baby cats?",
              "zh": "小猫是什么颜色的？"
            },
            {
              "en": "Yellow, brown and red.",
              "zh": "黄色、棕色和红色。"
            },
            {
              "en": "Black, orange and white.",
              "zh": "黑色、橙色和白色。"
            },
            {
              "en": "Be nice, please.",
              "zh": "请友善一点。"
            },
            {
              "en": "OK!",
              "zh": "好的！"
            }
          ]
        },
        {
          "title": "孩子们可以怎样帮忙",
          "kind": "activity",
          "lines": [
            {
              "en": "How can the children help?",
              "zh": "孩子们可以怎样帮忙？"
            },
            {
              "en": "Plant the flowers.",
              "zh": "种花。"
            },
            {
              "en": "Plant the trees.",
              "zh": "种树。"
            },
            {
              "en": "Water the flowers.",
              "zh": "给花浇水。"
            },
            {
              "en": "Water the trees.",
              "zh": "给树浇水。"
            },
            {
              "en": "We can help.",
              "zh": "我们可以帮忙。"
            },
            {
              "en": "OK.",
              "zh": "好的。"
            }
          ]
        },
        {
          "title": "数水果",
          "kind": "activity",
          "lines": [
            {
              "en": "How many fruits?",
              "zh": "有多少个水果？"
            },
            {
              "en": "Two apples.",
              "zh": "两个苹果。"
            },
            {
              "en": "Three apples.",
              "zh": "三个苹果。"
            },
            {
              "en": "Three oranges.",
              "zh": "三个橙子。"
            },
            {
              "en": "Four oranges.",
              "zh": "四个橙子。"
            },
            {
              "en": "Five bananas.",
              "zh": "五根香蕉。"
            },
            {
              "en": "Six bananas.",
              "zh": "六根香蕉。"
            },
            {
              "en": "Nine grapes.",
              "zh": "九颗葡萄。"
            },
            {
              "en": "Ten grapes.",
              "zh": "十颗葡萄。"
            },
            {
              "en": "Do you like bananas, Binbin?",
              "zh": "你喜欢香蕉吗，斌斌？"
            },
            {
              "en": "Yes, I do. Thanks.",
              "zh": "是的，我喜欢。谢谢。"
            }
          ]
        },
        {
          "title": "选择图片并表演",
          "kind": "activity",
          "lines": [
            {
              "en": "Choose a picture above and act it out.",
              "zh": "选择上面的一幅图片，表演出来。"
            }
          ]
        }
      ],
