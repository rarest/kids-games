    {
      "page": 76,
      "title": "一起玩、吟唱与做客礼仪",
      "blocks": [
        {
          "title": "Read and talk",
          "kind": "dialogue",
          "lines": [
            {
              "en": "Read and talk.",
              "zh": "读一读，说一说。"
            },
            {
              "en": "Let's play together!",
