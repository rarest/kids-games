            {
              "en": "Read aloud.",
              "zh": "大声朗读。"
            },
            {
              "en": "Mum! Dad! This is Wu Binbin. And this is Mike Black.",
              "zh": "妈妈！爸爸！这是吴斌斌。这是迈克·布莱克。"
            },
            {
              "en": "Hi, Binbin! Hello, Mike! Nice to meet you.",
              "zh": "嗨，斌斌！你好，迈克！很高兴认识你。"
            },
            {
              "en": "Nice to meet you too.",
              "zh": "我也很高兴认识你。"
            },
            {
              "en": "This is for you.",
              "zh": "这是送给你的。"
            },
            {
              "en": "Thank you.",
              "zh": "谢谢你。"
            }
          ]
        },
