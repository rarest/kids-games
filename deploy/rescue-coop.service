[Unit]
Description=Cooperative rescue rangers
After=network.target
[Service]
Type=simple
WorkingDirectory=%h/games-site
ExecStart=/usr/bin/node %h/games-site/rescue/server.mjs
Environment=PORT=8788
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=512M
[Install]
WantedBy=default.target
