# Names only. Replace placeholders in the cloud console / private secret store.
# Do not copy real values into this repository or the client package.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
PUBLIC_ORIGIN=https://games.nblord.com
DATABASE_URL=postgresql://REPLACE_PRIVATE_CONNECTION
VISITOR_SECRET=REPLACE_PERSISTENT_SECRET_AT_LEAST_32_CHARACTERS
AUTH_SECRET=REPLACE_PERSISTENT_AUTH_SECRET_AT_LEAST_32_CHARACTERS
WECHAT_MINI_APP_ID=REPLACE_WITH_THIS_MINIPROGRAM_APPID
WECHAT_MINI_APP_SECRET=REPLACE_IN_PRIVATE_SECRET_STORE
# Optional: accepted only when HTTP and host 127.0.0.1; see README.
# SPEECH_LOCAL_URL=http://127.0.0.1:8769
# Optional SMTP requires its own private configuration. It is not bundled here.
